# Copy to .env to use an Immich album instead of the photos/ folder: the server, an API key
# (Account Settings -> API Keys, read access to albums and assets), and the album (its id is
# the last part of the album's URL). With all three set, the folder is ignored.
IMMICH_URL=http://immich.local:2283
IMMICH_API_KEY=
IMMICH_ALBUM_ID=
