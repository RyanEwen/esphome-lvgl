# Gitignore settings for ESPHome
#
# No leading slash on the build/secret patterns: a build run from a subdirectory puts its
# own .esphome/ and secrets.yaml there, and an anchored pattern would let `git add -A`
# sweep them in.
.esphome/
secrets.yaml
.env
__pycache__/

# Yours, not the repo's: your panels' configs and your house (pages, rooms, settings).
# Configs at the top level are ignored except the examples and common.yaml, so the
# ESPHome dashboard still finds yours here. See docs/getting-started.md.
/*.yaml
!/*-example.yaml
!/common.yaml
/private/
/snapshots/
# your own screensaver photos (the demo one and its note stay)
/tools/photo-frame/photos/*
!/tools/photo-frame/photos/demo.jpg
!/tools/photo-frame/photos/README.txt

# macOS
.DS_Store

# Local to this checkout (server-side tooling and retired configs)
.venv/
.vscode/
archive/
core
cmds
